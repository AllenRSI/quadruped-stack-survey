<mujoco model="quad12">
  <!-- 12 自由度四足（3 DOF/腿），为复现 convex MPC / PPO 运控而建的最小模型。
       质量与尺度参考 Unitree Go1 量级，非官方模型。 -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <default>
    <default class="leg">
      <joint damping="0.02" armature="0.004" frictionloss="0.02"/>
      <motor ctrllimited="true" ctrlrange="-24 24"/>
    </default>
    <default class="foot">
      <geom contype="1" conaffinity="1" friction="1.0 0.02 0.001" solref="0.01 1"/>
    </default>
  </default>

  <worldbody>
    <geom name="floor" type="plane" size="30 30 0.05" rgba="0.45 0.45 0.48 1" friction="1.0 0.02 0.001"/>
    <light directional="true" pos="0 0 3" dir="0 0 -1" diffuse="0.6 0.6 0.6"/>
    <body name="torso" pos="0 0 0.32">
      <freejoint name="root"/>
      <geom name="torso_geom" type="box" size="0.17 0.075 0.045" mass="6.0" rgba="0.25 0.45 0.75 1"/>
      <site name="imu" pos="0 0 0" size="0.012" rgba="1 0 0 1"/>

      <!-- 前右 FR -->
      <body name="FR_hip" pos="0.15 -0.075 0">
        <joint name="FR_roll" class="leg" axis="1 0 0" range="-0.7 0.7"/>
        <geom type="capsule" fromto="0 0 0 0 -0.02 0" size="0.025" class="leg" mass="0.15"/>
        <body name="FR_thigh" pos="0 0 0">
          <joint name="FR_pitch" class="leg" axis="0 1 0" range="-1.3 1.3"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.18" size="0.022" class="leg" mass="0.75"/>
          <body name="FR_shin" pos="0 0 -0.18">
            <joint name="FR_knee" class="leg" axis="0 1 0" range="-2.5 0.3"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.18" size="0.016" class="leg" mass="0.35"/>
            <geom name="FR_foot_geom" type="sphere" size="0.022" pos="0 0 -0.18" class="foot" mass="0.05"/>
            <site name="FR_foot" pos="0 0 -0.18" size="0.01" rgba="0 1 0 1"/>
          </body>
        </body>
      </body>

      <!-- 前左 FL -->
      <body name="FL_hip" pos="0.15 0.075 0">
        <joint name="FL_roll" class="leg" axis="1 0 0" range="-0.7 0.7"/>
        <geom type="capsule" fromto="0 0 0 0 0.02 0" size="0.025" class="leg" mass="0.15"/>
        <body name="FL_thigh" pos="0 0 0">
          <joint name="FL_pitch" class="leg" axis="0 1 0" range="-1.3 1.3"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.18" size="0.022" class="leg" mass="0.75"/>
          <body name="FL_shin" pos="0 0 -0.18">
            <joint name="FL_knee" class="leg" axis="0 1 0" range="-2.5 0.3"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.18" size="0.016" class="leg" mass="0.35"/>
            <geom name="FL_foot_geom" type="sphere" size="0.022" pos="0 0 -0.18" class="foot" mass="0.05"/>
            <site name="FL_foot" pos="0 0 -0.18" size="0.01" rgba="0 1 0 1"/>
          </body>
        </body>
      </body>

      <!-- 后右 RR -->
      <body name="RR_hip" pos="-0.15 -0.075 0">
        <joint name="RR_roll" class="leg" axis="1 0 0" range="-0.7 0.7"/>
        <geom type="capsule" fromto="0 0 0 0 -0.02 0" size="0.025" class="leg" mass="0.15"/>
        <body name="RR_thigh" pos="0 0 0">
          <joint name="RR_pitch" class="leg" axis="0 1 0" range="-1.3 1.3"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.18" size="0.022" class="leg" mass="0.75"/>
          <body name="RR_shin" pos="0 0 -0.18">
            <joint name="RR_knee" class="leg" axis="0 1 0" range="-2.5 0.3"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.18" size="0.016" class="leg" mass="0.35"/>
            <geom name="RR_foot_geom" type="sphere" size="0.022" pos="0 0 -0.18" class="foot" mass="0.05"/>
            <site name="RR_foot" pos="0 0 -0.18" size="0.01" rgba="0 1 0 1"/>
          </body>
        </body>
      </body>

      <!-- 后左 RL -->
      <body name="RL_hip" pos="-0.15 0.075 0">
        <joint name="RL_roll" class="leg" axis="1 0 0" range="-0.7 0.7"/>
        <geom type="capsule" fromto="0 0 0 0 0.02 0" size="0.025" class="leg" mass="0.15"/>
        <body name="RL_thigh" pos="0 0 0">
          <joint name="RL_pitch" class="leg" axis="0 1 0" range="-1.3 1.3"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.18" size="0.022" class="leg" mass="0.75"/>
          <body name="RL_shin" pos="0 0 -0.18">
            <joint name="RL_knee" class="leg" axis="0 1 0" range="-2.5 0.3"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.18" size="0.016" class="leg" mass="0.35"/>
            <geom name="RL_foot_geom" type="sphere" size="0.022" pos="0 0 -0.18" class="foot" mass="0.05"/>
            <site name="RL_foot" pos="0 0 -0.18" size="0.01" rgba="0 1 0 1"/>
          </body>
        </body>
      </body>

    </body>
  </worldbody>

  <actuator>
    <motor name="FR_roll_m"  joint="FR_roll"  class="leg" gear="1"/>
    <motor name="FR_pitch_m" joint="FR_pitch" class="leg" gear="1"/>
    <motor name="FR_knee_m"  joint="FR_knee"  class="leg" gear="1"/>
    <motor name="FL_roll_m"  joint="FL_roll"  class="leg" gear="1"/>
    <motor name="FL_pitch_m" joint="FL_pitch" class="leg" gear="1"/>
    <motor name="FL_knee_m"  joint="FL_knee"  class="leg" gear="1"/>
    <motor name="RR_roll_m"  joint="RR_roll"  class="leg" gear="1"/>
    <motor name="RR_pitch_m" joint="RR_pitch" class="leg" gear="1"/>
    <motor name="RR_knee_m"  joint="RR_knee"  class="leg" gear="1"/>
    <motor name="RL_roll_m"  joint="RL_roll"  class="leg" gear="1"/>
    <motor name="RL_pitch_m" joint="RL_pitch" class="leg" gear="1"/>
    <motor name="RL_knee_m"  joint="RL_knee"  class="leg" gear="1"/>
  </actuator>
</mujoco>
